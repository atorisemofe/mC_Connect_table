@model mC_Connect_table.Models.FrontViewModel

@{
    ViewData["Title"] = "Restaurant Front of House";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Include Bootstrap CSS for styling -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .table-card {
            border: 2px solid #4CAF50;
            border-radius: 10px;
            padding: 20px;
            margin: 20px;
            text-align: center;
            background-color: #f8f9fa;
            transition: 0.3s;
        }

        .table-card:hover {
            background-color: #e8f5e9;
        }

        .table-status {
            font-size: 16px;
            font-weight: bold;
        }

        .occupied {
            color: red;
        }

        .available {
            color: green;
        }

        .table-number {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .action-btn {
            margin-top: 15px;
        }
        .help-requested-flash {
            color: red;
            font-weight: bold;
            animation: flash 1s infinite;
        }

        @* @keyframes flash {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        } *@

    </style>
</head>
<body>

<div class="container">
    <h1 class="text-center mt-4">Star Micronics Restaurant</h1>

    @* <!-- Display Notification Data -->
    @if (Model.Notification != null)
    {
        <div class="alert alert-info">
            <strong>Notification:</strong> @Model.Notification.Message
        </div>
    } *@

    <!-- Display the list of tables -->
    <div class="row">
        @foreach (var table in Model.Tables)
        {
            <div class="col-md-4">
                <div class="table-card" data-mctid="@table.MctId">
                    <div class="table-number">Table @table.TableNumber</div>
                    <div class="table-status @(table.IsActive ? "occupied" : "available")" 
                        id="status-table-@table.TableNumber">
                        @(table.IsActive ? "Occupied" : "Available")
                    </div>
                    <button 
                        class="btn @(table.IsActive ? "btn-danger" : "btn-success") action-btn" 
                        onclick="occupyTable('@table.TableNumber', '@table.MctId')">
                        @(table.IsActive ? "Clear Table" : "Seat Table")
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Include Bootstrap JS and jQuery -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    function occupyTable(tableId, mctID) {
        var tableStatus = document.getElementById("status-table-" + tableId);
        var button = event.target;

        if (tableStatus.classList.contains('available')) {
            // Prompt for customer name when seating the table
            var customerName = prompt("Enter customer name:");
            if (customerName === null || customerName.trim() === "") {
                alert("Customer name is required to seat the table.");
                return;  // Do not proceed if the name is not provided
            }

            // Table is currently available, so seat the table
            tableStatus.textContent = 'Occupied';
            tableStatus.classList.remove('available');
            tableStatus.classList.remove('help-requested-flash');
            tableStatus.classList.add('occupied');
            button.classList.remove('btn-success');
            button.classList.add('btn-danger');
            button.textContent = 'Clear Table';

            // Send PUT request to update table status to occupied (IsActive = true)
            sendPutRequest(tableId, true, customerName);
            sendInstructions(mctID);

        } else {
            // Table is currently occupied, so clear the table
            tableStatus.textContent = 'Available';
            tableStatus.classList.remove('occupied');
            tableStatus.classList.remove('help-requested-flash');
            tableStatus.classList.add('available');
            button.classList.remove('btn-danger');
            button.classList.add('btn-success');
            button.textContent = 'Seat Table';

            // Send PUT request to update table status to available (IsActive = false)
            sendPutRequest(tableId, false, null);  // No customer name needed for clearing
            sendInstructions(mctID);
        }
    }

    function sendPutRequest(tableId, isActive, customerName) {
        // Build the request URL with the customer name (if seating the table)
        let url = `/RestaurantTables/SetTableStatus/${tableId}?isActive=${isActive}`;
        if (isActive && customerName) {
            url += `&customerName=${encodeURIComponent(customerName)}`;
        }

        // Use fetch API to send a PUT request to update the table's IsActive status
        fetch(url, {
            method: 'PUT',
        })
        .then(response => {
            if (response.ok) {
                console.log("Table status updated successfully.");
            } else {
                console.error("Error updating table status.");
            }
        });
    }



    function sendInstructions(mctID) {
        // Hardcoded base64 image (replace this with the actual base64 image you want to use)
        const hardcodedImageBase64 = "data:image/png;base64,";

        // Prepare the request body
        const requestBody = {
            device_ids: [mctID],  // Example, adjust device ID as needed
            led: 2,  // Example value, adjust as needed
            buzzer: {
                on_time: 150,  // Example value, adjust as needed
                off_time: 250, // Example value, adjust as needed
                repetitions: 1 // Example value, adjust as needed
            },
            content: hardcodedImageBase64  // Send the hardcoded Base64 image
        };

        tryApiCall('/update-image', 'PUT', requestBody, '#responseUpdateImage');
    }

    function tryApiCall(endpoint, method, body, responseElement) {
        const apiKey = "00a7d7db-37e9-4737-8400-5c778d6cc05c";
    
        if (!apiKey) {
            alert('Please enter your Star-Api-Key.');
            return;
        }
        const url = `/proxy${endpoint}`;

        fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'Star-Api-Key': apiKey
            },
            body: method !== 'GET' ? JSON.stringify(body) : null
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            document.querySelector(responseElement).textContent = JSON.stringify(data, null, 2);
        })
        .catch(error => {
            document.querySelector(responseElement).textContent = 'Error: ' + error.message;
        });
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>

<script>
    // Create a connection to the SignalR hub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .build();

    // Define a function to handle incoming notifications
    connection.on("ReceiveNotification", (notification) => {
        // Find the matching table by deviceID (assuming you have a table card with data attributes)
        const matchingTableCard = document.querySelector(`[data-mctid="${notification.id}"]`);

        if (matchingTableCard) {
            const statusElement = matchingTableCard.querySelector('.table-status');

            // Check if we're already handling a HELP REQUESTED notification
            if (statusElement.classList.contains('help-requested-flash')) {
                console.log('HELP/CHECK REQUESTED already active for this table, skipping...');
                return;  // Prevent multiple HELP REQUESTED flashes at the same time for the same table
            }

            // Store the current original status ("Available" or "Occupied") in a data attribute
            const originalStatus = statusElement.textContent.trim();
            matchingTableCard.setAttribute('data-original-status', originalStatus);

            console.log(`Original status of table: ${originalStatus}`);

            if (notification.action == 1){
                // Change the status text to "HELP REQUESTED" and make it flash
                statusElement.textContent = "HELP REQUESTED";
                statusElement.classList.add('help-requested-flash');
            }else if (notification.action == 3){
                // Change the status text to "CHECK REQUESTED" and make it flash
                statusElement.textContent = "CHECK REQUESTED";
                statusElement.classList.add('help-requested-flash');
            }else if (notification.action == "order_ready") {  // Add a condition for "ORDER READY"
                statusElement.textContent = "ORDER READY";
                statusElement.classList.add('help-requested-flash');
            }else if (notification.status == 'New'){ return; };

            // Set a timer to revert to the original state after 1 minute
            setTimeout(() => {
                // Retrieve the original status from the data attribute
                const storedOriginalStatus = matchingTableCard.getAttribute('data-original-status');

                // Check if the storedOriginalStatus is valid and revert back to it
                if (storedOriginalStatus) {
                    console.log(`Reverting status to: ${storedOriginalStatus}`);
                    statusElement.textContent = storedOriginalStatus;
                    statusElement.classList.remove('help-requested-flash');
                } else {
                    console.error("Failed to retrieve original status for reverting.");
                }
            }, 30000); // 30 seconds = 30000 milliseconds
        } else {
            console.error(`Table with deviceID ${notification.id} not found.`);
        }
    });


    // Start the SignalR connection
    connection.start().catch(err => console.error("SignalR connection error:", err));

</script>

</body>
</html>
