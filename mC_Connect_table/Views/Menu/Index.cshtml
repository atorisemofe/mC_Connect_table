        <label for="order-notes">Special Instructions (e.g., allergies):</label>
        <textarea id="order-notes" rows="4" placeholder="Add any special instructions or allergies here..."></textarea>
        @* <textarea id="order-notes" placeholder="Add notes (e.g., allergies, special instructions)" rows="4"></textarea> *@


        <button id="checkout" class="checkout-button" disabled onclick="checkout()">Checkout</button>
    </div>
</div>

<!-- Script for Cart functionality -->
<script>
    var cart = [];

    function addToCart(itemName, itemPrice) {
        cart.push({ name: itemName, price: itemPrice });
        updateCart();
    }

    function updateCart() {
        var cartItems = document.getElementById("cart-items");
        var totalPrice = 0;
        cartItems.innerHTML = "";

        cart.forEach(function (item) {
            var listItem = document.createElement("li");
            listItem.textContent = item.name + " - $" + item.price;
            cartItems.appendChild(listItem);
            totalPrice += item.price;
        });

        document.getElementById("total-price").textContent = "Total: $" + totalPrice.toFixed(2); // Update total price

        if (cart.length > 0) {
            document.getElementById("checkout").disabled = false;
        } else {
            document.getElementById("checkout").disabled = true;
        }
    }

    @* function checkout() {
        var order1 = {
            TableNumber: 1,  // Hardcoded value to test
            Status: "New",
            EntreeItems: ["Vegetable Stir Fry"],
            DrinkItems: ["Water"],
            DessertItems: []
        };
        var order = {
            TableNumber: parseInt(getTableNumber()),  // Assuming you have a way to get the table number
            Status: "New",
            EntreeItems: cart.filter(item => isEntree(item.name)).map(item => item.name),
            DrinkItems: cart.filter(item => isDrink(item.name)).map(item => item.name),
            DessertItems: cart.filter(item => isDessert(item.name)).map(item => item.name)
        };

        fetch('/Order/Create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(order1)
        })
        .then(response => response.json())
        .then(data => {
            alert("Order placed successfully!");
            // Clear the cart and reset UI
            cart = [];
            updateCart();
        })
        .catch(error => console.error('Error:', error));
    } *@

    function checkout() {
        var totalPrice = 0;
        cart.forEach(function(item) {
            totalPrice += item.price;
        });
        
        // Retrieve the notes entered by the user
        var orderNotesElement = document.getElementById('order-notes');
        var orderNotes = orderNotesElement.value;
        var order = {
            TableNumber: parseInt(getTableNumber()),  // Assuming you have a way to get the table number
            Status: "New",
            EntreeItems: cart.filter(item => isEntree(item.name)).map(item => item.name),
            DrinkItems: cart.filter(item => isDrink(item.name)).map(item => item.name),
            DessertItems: cart.filter(item => isDessert(item.name)).map(item => item.name),
            TotalPrice: totalPrice,
            Notes: orderNotes,
            MctId: getMctID(),
            SessionId: getCurrentSessionID()
        };

        fetch('/Order/Create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
                @* 'RequestVerificationToken': token // Add token here *@
            },
            body: JSON.stringify(order)
        })
        .then(response => {
            if (!response.ok) {
                return response.text().then(text => {
                    throw new Error(`Request failed with status ${response.status}: ${text}`);
                });
            }
            return response.json();
        })
        .then(data => {
            alert("Order placed successfully!");
            cart = [];
            updateCart();
            orderNotesElement.value = "";
        })
        .catch(error => console.error('Error:', error));
    }


    // Utility functions to categorize items (adjust logic as needed)
    function isEntree(itemName) {
        return ['Grilled Chicken', 'Steak', 'Vegetable Stir Fry'].includes(itemName);
    }

    function isDrink(itemName) {
        return ['Coca-Cola', 'Orange Juice', 'Water'].includes(itemName);
    }

    function isDessert(itemName) {
        return ['Chocolate Cake', 'Cheesecake', 'Ice Cream'].includes(itemName);
    }

    function getTableNumber() {
        // Extract the table number from the URL or another part of your app
        var urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('table') || 0;
    }
    function getMctID() {
        // Extract the table number from the URL or another part of your app
        var urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('mctid') || "";
    }
    function getCurrentSessionID() {
        // Extract the table number from the URL or another part of your app
        var urlParams = new URLSearchParams(window.location.search);
        return urlParams.get('sessionid') || "";
    }

    function calculateTotalPrice() {
        return cart.reduce(function (total, item) {
            return total + item.price;
        }, 0);
    }
</script>



<style>
.body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    padding: 20px;
}

.menu {
    flex-grow: 1;
    margin-right: 50px;
}

.menu-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3 columns layout */
    grid-gap: 20px;
    margin-bottom: 20px;
}

.menu-item {
    background-color: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
    @* width: calc(33% - 20px); *@
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.menu-item img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    margin-bottom: 10px;
}

.add-to-cart {
    background-color: #007bff;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
}

.add-to-cart:hover {
    background-color: #0056b3;
}

.cart {
    width: 25%;
    background-color: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    position: sticky;
    top: 20px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.cart h2 {
    margin-top: 0;
}

#cart-items {
    list-style-type: none;
    padding: 0;
}

#cart-items li {
    margin-bottom: 10px;
}

.checkout-button {
    width: 100%;
    background-color: #28a745;
    color: white;
    padding: 10px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

.checkout-button:disabled {
    background-color: #cccccc;
    cursor: not-allowed;
}

.checkout-button:hover:not(:disabled) {
    background-color: #218838;
}

</style>
