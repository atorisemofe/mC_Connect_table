@section Scripts {
    <script>
        document.getElementById('submitSurvey').addEventListener('click', function () {
            var sessionId = '@Model.FirstOrDefault()?.SessionId'; // Assuming sessionId is stored in the first order  
            var url = '/Payments/Survey?sessionid=' + sessionId;

            // Send AJAX request to submit the survey
            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({}),
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Redirect to the SurveyCompleted page after successful submission
                    window.location.href = '/Payments/SurveyCompleted';
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        });
    </script>
}
