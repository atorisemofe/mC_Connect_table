@model List<OrderViewModel>

@{
    ViewData["Title"] = "Kitchen Display";
    @* var antiForgeryToken = @Html.AntiForgeryToken(); *@

}
<meta http-equiv="refresh" content="60">
<div class="container">
    <h2>Kitchen Orders</h2>

    <div class="orders">
        @foreach (var order in Model)
        {
            <div class="order-card" id="order-@order.OrderNumber">
                <div class="order-header @order.Status.ToLower()">
                    <div class="order-number">#@order.OrderNumber</div>
                    <div class="order-info">
                        <span>Table No. @order.TableNumber</span>
                        <span>@DateTime.Now.ToString("hh:mm tt")</span> <!-- Current time for simplicity -->
                    </div>
                </div>

                <div class="order-body">
                    <h4>ENTREES</h4>
                    <ul>
                        @foreach (var item in order.EntreeItems)
                        {
                            <li>@item</li>
                        }
                    </ul>

                    @if (!string.IsNullOrEmpty(order.Notes))
                    {
                        <div class="order-notes">
                            <p>NOTES: @order.Notes</p>
                        </div>
                    }
                    </div>

                <div class="order-footer">
                    <label for="order-status-@order.OrderNumber">Status:</label>
                    <select id="order-status-@order.OrderNumber" class="order-status-dropdown" onchange="updateOrderStatus('@order.OrderNumber', '@order.MctId')">
                        <option value="New" selected="@(order.Status == "New" ? "selected" : null)">New</option>
                        <option value="Preparing" selected="@(order.Status == "Preparing" ? "selected" : null)">Preparing</option>
                        <option value="Ready" selected="@(order.Status == "Ready" ? "selected" : null)">Ready</option>
                        <option value="Delivered" selected="@(order.Status == "Delivered" ? "selected" : null)">Delivered</option>
                    </select>

                    <!-- Done button to delete the order -->
                    <button onclick="deleteOrder(@order.OrderNumber)" class="done-button">Done</button>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Create a connection to the SignalR hub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/notificationHub")
        .build();
    
    // Start the SignalR connection
    connection.start().catch(err => console.error("SignalR connection error:", err));

    function updateOrderStatus(orderId,mctID) {
        @* if (!mctID || mctID === 'null') {
        console.error('Invalid or missing MCT ID for order ' + orderId);
        return;
        } *@
        var orderCard = document.getElementById('order-' + orderId);
        var dropdown = document.getElementById('order-status-' + orderId);
        var status = dropdown.value;
        var header = orderCard.querySelector('.order-header');

        // Remove any existing status classes
        header.classList.remove("preparing", "ready", "delivered", "new");

        // Add the corresponding class based on selected value
        if (status === "Preparing") {
            header.classList.add("preparing");
            sendOrderStatus("preparing",mctID)
            // Set a 30-second delay before calling sendInstructions()
            setTimeout(function() {
                sendInstructions(mctID);
            }, 30000); // 30000 milliseconds = 30 seconds
        } else if (status === "Ready") {
            header.classList.add("ready");
            notifyOrderReady(mctID);
            sendOrderStatus("ready",mctID);
            // Set a 30-second delay before calling sendInstructions()
            setTimeout(function() {
                sendInstructions(mctID);
            }, 30000); // 30000 milliseconds = 30 seconds
        } else if (status === "Delivered") {
            header.classList.add("delivered");
        } else if (status === "New") {
            header.classList.add("new");
        }
        // Update the status in the database
        updateOrderStatusDB(orderId, status);
    }

    function notifyOrderReady(mctId) {
        connection.invoke("SendNotification", {
            id: mctId,
            action: "order_ready"
        }).catch(err => console.error("Error sending notification:", err));
    }

    function deleteOrder(orderId) {
        if (confirm("Are you sure you want to mark this order as done and delete it?")) {
            @* var token = document.querySelector('input[name="__RequestVerificationToken"]').value; *@
            fetch(`/Order/Delete/${orderId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                    @* 'RequestVerificationToken': token // Add token here *@
                }
            })
            .then(response => {
                if (response.ok) {
                    // Remove the order from the UI
                    document.getElementById('order-' + orderId).remove();
                    console.log("Order marked as done and deleted.");
                } else {
                    alert("Failed to delete the order.");
                }
            })
            .catch(error => console.error('Error:', error));
        }
    }

    function updateOrderStatusDB(orderId, newStatus) {
        const requestBody = {
            OrderNumber: parseInt(orderId),
            Status: newStatus
        };

        fetch('/Order/UpdateStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                // Add CSRF token here if required
            },
            body: JSON.stringify(requestBody)
        })
        .then(response => response.json())  // Convert the response to JSON
        .then(data => {
            if (data.success) {
                console.log("Order status updated successfully.");
                @* alert(data.message);  // Optional success alert *@
            } else {
                alert("Failed to update the order status.");
                @* alert(data.message);  // Optional failure alert *@
            }
        })
        .catch(error => {
            console.error('Error updating order status:', error);
        });
    }

    function sendInstructions(mctID) {
        // Hardcoded base64 image (replace this with the actual base64 image you want to use)
        const hardcodedImageBase64 = "data:image/png;base64,";

        // Prepare the request body
        const requestBody = {
            device_ids: [mctID],  // Example, adjust device ID as needed
            led: 2,  // Example value, adjust as needed
            buzzer: {
                on_time: 150,  // Example value, adjust as needed
                off_time: 250, // Example value, adjust as needed
                repetitions: 1 // Example value, adjust as needed
            },
            content: hardcodedImageBase64  // Send the hardcoded Base64 image
        };

        tryApiCall('/update-image', 'PUT', requestBody);
    }

    function tryApiCall(endpoint, method, body, responseElement) {
        const apiKey = "00a7d7db-37e9-4737-8400-5c778d6cc05c";
    
        if (!apiKey) {
            alert('Please enter your Star-Api-Key.');
            return;
        }
        const url = `/proxy${endpoint}`;

        fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'Star-Api-Key': apiKey
            },
            body: method !== 'GET' ? JSON.stringify(body) : null
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        });
    }

    function sendOrderStatus(orderStatus,mctID){
        // Define the Base64 images for different statuses
        const preparingImageBase64 = "data:image/png;base64,"; // Replace with actual Base64 string for "Preparing"
        const readyImageBase64 = "data:image/png;base64,";     // Replace with actual Base64 string for "Ready"

        // Set content based on the orderStatus
        let contentImage;
        if (orderStatus === "preparing") {
            contentImage = preparingImageBase64;
        } else if (orderStatus === "ready") {
            contentImage = readyImageBase64;
        } else {
            console.error("Invalid order status: " + orderStatus);
            return;
        }
        // Prepare the request body
        const requestBody = {
            device_ids: [mctID],  // Example, adjust device ID as needed
            led: 2,  // Example value, adjust as needed
            buzzer: {
                on_time: 150,  // Example value, adjust as needed
                off_time: 250, // Example value, adjust as needed
                repetitions: 1 // Example value, adjust as needed
            },
            content: contentImage  // Send the hardcoded Base64 image
        };

        tryApiCall('/update-image', 'PUT', requestBody);
    }
    function tryApiCall(endpoint, method, body) {
        const apiKey = "00a7d7db-37e9-4737-8400-5c778d6cc05c";
    
        if (!apiKey) {
            alert('Please enter your Star-Api-Key.');
            return;
        }
        const url = `/proxy${endpoint}`;

        fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'Star-Api-Key': apiKey
            },
            body: method !== 'GET' ? JSON.stringify(body) : null
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        });
    }
</script>

<!-- Add the below CSS for styling the orders -->
<style>
